        <mxCell id="auw-0-DtDo2dnSEmdetF-7" parent="auw-0-DtDo2dnSEmdetF-5" style="connectable=0;recursiveResize=0;strokeColor=inherit;fillColor=none;align=left;whiteSpace=wrap;html=1;spacingLeft=10;fontSize=16;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;indiquer les compétences qu&#39;il possède et est prêt à offrir, parmi la liste proposée par l&#39;application&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;indiquer les créneaux où il recherche quelqu&#39;un pour l&#39;aider dans une activité,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;afficher les prochains créneaux où un utilisateur recherche quelqu&#39;un pour une activité dont l&#39;utilisateur connecté possède la compétence associée,&lt;/span&gt;&lt;/li&gt;&lt;li&gt;se positionner pour apporter son aide sur les créneaux affichés ( point précédent).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="793" x="280" as="geometry">
            <mxRectangle height="230" width="793" as="alternateBounds" />
