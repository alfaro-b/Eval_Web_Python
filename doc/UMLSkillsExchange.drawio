          <mxGeometry height="230" width="1073" y="190" as="geometry" />
        </mxCell>
        <mxCell id="auw-0-DtDo2dnSEmdetF-6" parent="auw-0-DtDo2dnSEmdetF-5" style="connectable=0;recursiveResize=0;strokeColor=inherit;fillColor=none;align=left;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;spacingLeft=20;" value="Pour les utilisateurs connectés&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;,&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;div&gt;l&#39;application permet :&amp;nbsp;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="280" as="geometry">
            <mxRectangle height="230" width="280" as="alternateBounds" />
